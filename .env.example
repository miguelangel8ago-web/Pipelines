# Copia este archivo como ".env" y ajusta los valores.
# Sirve tanto para el SQL Server de docker-compose (local) como para
# Azure SQL Database (ahí host/usuario/clave los da el portal de Azure).

# Solo tienes instalado el driver antiguo "SQL Server"; instala el
# "ODBC Driver 18 for SQL Server" de Microsoft y borra esta línea,
# o déjala en "SQL Server" si prefieres usar el que ya tienes.
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=pipelines_empresas
MSSQL_USER=sa
MSSQL_PASSWORD=Changeme!2024
# En local (contenedor sin certificado real) deja "yes". En Azure SQL
# también puede quedar en "yes" para simplificar el prototipo.
MSSQL_TRUST_SERVER_CERTIFICATE=yes
